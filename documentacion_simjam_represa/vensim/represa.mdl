{UTF-8}
Embalse_Volumen= INTEG(
	Entrada_Rio-Salida_Turbinas-Salida_Vertedero-Perdida_Filtracion,
		30)
	~	hm3
	~	Volumen almacenado en el embalse (nivel). V0 = 30 hm3
	|

Entrada_Rio= 0.5
	~	hm3/Hour
	~	Caudal del rio Q_rio. Para tormenta: 0.5+STEP(2,30)-STEP(2,90) en horas simuladas
	|

Salida_Turbinas= K_t*Apertura_Turbina
	~	hm3/Hour
	~	Caudal turbinado Q_t = K_t*u_t
	|

Salida_Vertedero= K_v*Apertura_Vertedero
	~	hm3/Hour
	~	Caudal vertido Q_v = K_v*u_v
	|

Perdida_Filtracion= k_perdida*Embalse_Volumen
	~	hm3/Hour
	~	Perdida por filtracion k_perd*V
	|

Cabeza_Hidraulica= 20+0.8*Embalse_Volumen
	~	m
	~	Cabeza hidraulica H = 20 + 0.8 V
	|

Potencia_Generada= 2.45*Cabeza_Hidraulica*Salida_Turbinas
	~	MW
	~	Potencia P = 2.45 H Q_t
	|

Apertura_Turbina= 0.44+STEP(-0.1,2)
	~	Dmnl
	~	u_t: equilibrio 0.44 con escalon de -0.1 a las 2 h (ajusta al de tu CSV)
	|

Apertura_Vertedero= 0
	~	Dmnl
	~	u_v: 0 en el escalon de referencia
	|

K_t= 1
	~	hm3/Hour/Dmnl
	~	Ganancia de turbinas
	|

K_v= 2
	~	hm3/Hour/Dmnl
	~	Ganancia del vertedero
	|

k_perdida= 0.002
	~	1/Hour
	~	Coeficiente de filtracion
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 20
	~	Hour
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Hour
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Hour [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.01
	~	Hour [0,?]
	~	The time step for the simulation.
	|

